<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    bootstrap="tests/bootstrap.app.php"
    colors="false"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.2/phpunit.xsd"
    cacheDirectory=".phpunit.cache"
>
	<php>
		<ini name="error_reporting" value="-1" />

        <!--
            Default database DSN, used by general tests. The prefix before ':' selects the
            platform: pdo_mysql, pdo_pgsql, pdo_sqlsrv, pdo_oracle or pdo_sqlite.
            An environment variable with the same name takes precedence over this value.
            Start database servers in the background first (for example `docker compose up -d`).
        -->
        <!--<env name="WINDWALKER_TEST_DB_DSN" value="pdo_mysql:host=127.0.0.1;port=3306;dbname=earth_test;user=root;password=ut1234;prefix=ww_" />-->

	</php>

	<testsuites>
		<testsuite name="Unit">
			<directory>tests</directory>
		</testsuite>
	</testsuites>

    <!-- Code Coverage -->
    <source ignoreIndirectDeprecations="true">
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
