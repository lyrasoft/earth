<?xml version="1.0" encoding="UTF-8"?>
<configuration>
   <system.webServer>
       <directoryBrowse enabled="false" />
       <rewrite>
           <rules>
               <rule name="Block dot directories" stopProcessing="true">
                   <match url="^(www/)?\.(git|idea|github|vscode|svn|hg)(/|$)" ignoreCase="true" />
                   <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
               </rule>
               <rule name="Block existing files in the project root" stopProcessing="true">
                   <match url="^[^/]+$" ignoreCase="false" />
                   <conditions>
                       <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" />
                   </conditions>
                   <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
               </rule>
           </rules>
       </rewrite>
   </system.webServer>
</configuration>
